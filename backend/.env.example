# ========================================================
# GEOSCOPE BACKEND ENVIRONMENT VARIABLES
# ========================================================

# Server Port (Render sets this dynamically)
PORT=5002

# Node Environment
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/geoscope?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Google Maps Platform Places API Key
GOOGLE_MAPS_API_KEY=
